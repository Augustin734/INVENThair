# Copier ce fichier en .env puis compléter. .env n'est jamais commité.

# Chemin de la base SQLite (par défaut : inventhair.db à la racine du projet)
# INVENTHAIR_DB=/home/maud/INVENThair/inventhair.db

# Envoi de la liste d'achat par mail. Tant que SMTP_HOTE et SMTP_EXPEDITEUR sont vides,
# l'appli le signale au lieu d'envoyer.
# Adresse proposée par défaut dans l'écran Liste d'achat
MAIL_DESTINATAIRE_DEFAUT=
# Serveur d'envoi de ta messagerie (ex. smtp.gmail.com, smtp.orange.fr, ssl0.ovh.net)
SMTP_HOTE=
# 587 en général (STARTTLS), 465 pour le SSL direct
SMTP_PORT=587
# starttls, ssl ou aucune (par défaut : ssl sur le port 465, starttls sinon)
SMTP_SECURITE=
SMTP_UTILISATEUR=
# Pour Gmail : un « mot de passe d'application », pas le mot de passe du compte
SMTP_MOT_DE_PASSE=
# Adresse d'envoi, ex. INVENThair <maud@exemple.fr>
SMTP_EXPEDITEUR=
